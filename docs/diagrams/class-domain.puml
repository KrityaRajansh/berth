@startuml class-domain
!include _style.iuml
skinparam linetype polyline
hide empty methods

class User {
  id: UUID
  full_name: str
  email: str
  mobile: str
  password_hash: str
  role: Role
  created_at: datetime
}

class Station {
  id: int
  code: str
  name: str
  city: str
  is_active: bool
}

class Train {
  id: int
  number: str
  name: str
  running_days: int
  is_active: bool
  --
  runs_on(day: date): bool
}

class RouteStop {
  seq: int
  arrival: time [0..1]
  departure: time [0..1]
  day_offset: int
  distance_km: int
}

class Coach {
  code: str
  travel_class: TravelClass
  berth_count: int
}

class TrainRun {
  id: int
  run_date: date
  status: RunStatus
  chart_prepared_at: datetime [0..1]
}

class TrainRunClass <<lock row>> {
  travel_class: TravelClass
  berth_capacity: int
  waitlist_limit: int
}

class Booking {
  id: UUID
  pnr: str [0..1]
  travel_class: TravelClass
  from_seq: int
  to_seq: int
  journey_date: date
  status: BookingStatus
  total_fare_paise: int
  confirm_only: bool
  created_at: datetime
  expires_at: datetime
}

class Passenger {
  id: int
  seq_no: int
  name: str
  age: int
  gender: Gender
  berth_pref: BerthType [0..1]
  status: PassengerStatus
  coach_code: str [0..1]
  berth_no: int [0..1]
  berth_type: BerthType [0..1]
  wl_seq: int [0..1]
  booking_status_label: str
  fare_paise: int
  refund_paise: int
}

class Payment {
  id: UUID
  amount_paise: int
  method: str
  status: PaymentStatus
  gateway_ref: str [0..1]
  created_at: datetime
}

class Refund {
  id: UUID
  amount_paise: int
  reason: RefundReason
  status: str
  gateway_ref: str
  created_at: datetime
}

class AuditEvent {
  id: int
  actor_id: UUID [0..1]
  event_type: str
  entity: str
  entity_id: str
  data: json
  created_at: datetime
}

class JobRun {
  id: int
  job_name: str
  started_at: datetime
  finished_at: datetime [0..1]
  status: str
  items_processed: int
  detail: str [0..1]
}

enum Role {
  PASSENGER
  ADMIN
}

enum TravelClass {
  SL
  AC3
  AC2
  AC1
}

enum BookingStatus {
  PENDING_PAYMENT
  BOOKED
  FAILED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum PassengerStatus {
  CNF
  WL
  CAN
}

enum RunStatus {
  SCHEDULED
  CHART_PREPARED
  COMPLETED
  CANCELLED
}

enum Gender {
  M
  F
  T
}

enum BerthType {
  LB
  MB
  UB
  SL
  SU
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

enum RefundReason {
  USER_CANCELLATION
  CHART_PREPARED
  RUN_CANCELLED
}

Train "1" *-- "2..*" RouteStop : route
RouteStop "*" --> "1" Station
Train "1" *-- "1..*" Coach : composition
Train "1" -- "*" TrainRun : runs as
TrainRun "1" *-- "1..4" TrainRunClass : inventory
User "1" -- "*" Booking : makes
TrainRun "1" -- "*" Booking
Booking "*" --> "1" Station : from
Booking "*" --> "1" Station : to
Booking "1" *-- "1..6" Passenger
Booking "1" -- "*" Payment : attempts
Payment "1" -- "*" Refund

Role -[hidden]- TravelClass
TravelClass -[hidden]- BookingStatus
BookingStatus -[hidden]- PassengerStatus
PassengerStatus -[hidden]- RunStatus
Gender -[hidden]- BerthType
BerthType -[hidden]- PaymentStatus
PaymentStatus -[hidden]- RefundReason
@enduml
