!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #3A3A3A
skinparam ArrowFontSize 11
skinparam BorderColor #4A4A4A
skinparam NoteBackgroundColor #FFFDE8
skinparam NoteBorderColor #B8B08A
skinparam classAttributeIconSize 0
skinparam linetype ortho

skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #4A4A4A
  HeaderBackgroundColor #E9EEF5
  StereotypeFontColor #555555
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #8A8A8A
  FontStyle bold
}

skinparam component {
  BackgroundColor #F4F7FB
  BorderColor #4A4A4A
}

skinparam usecase {
  BackgroundColor #F4F7FB
  BorderColor #4A4A4A
}

skinparam actor {
  BorderColor #3A3A3A
  BackgroundColor #FFFFFF
}

skinparam state {
  BackgroundColor #F4F7FB
  BorderColor #4A4A4A
  StartColor #3A3A3A
  EndColor #3A3A3A
}

skinparam sequence {
  LifeLineBorderColor #8A8A8A
  ParticipantBackgroundColor #F4F7FB
  ParticipantBorderColor #4A4A4A
  ActorBorderColor #3A3A3A
  GroupBorderColor #8A8A8A
  GroupBackgroundColor #F2F2F2
  BoxBorderColor #BBBBBB
}

skinparam database {
  BackgroundColor #F4F7FB
  BorderColor #4A4A4A
}

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #6A6A6A
}
