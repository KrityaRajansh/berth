@startuml class-jobs
!include _style.iuml
skinparam linetype polyline
hide empty attributes

class JobRunner {
  + run(job: Job, today: date): JobRun
}

interface Job {
  + name: str
  + execute(session, today: date): int
}

class RunGenerationJob {
  + execute(session, today): int
}

class ChartPreparationJob {
  + execute(session, today): int
}

class JourneyCompletionJob {
  + execute(session, today): int
}

class PaymentExpiryJob {
  + execute(session, today): int
}

class JobRun {
  job_name: str
  started_at: datetime
  finished_at: datetime
  status: str
  items_processed: int
}

class CancellationService
class PaymentService

JobRunner --> Job : runs
JobRunner --> JobRun : records
RunGenerationJob ..|> Job
ChartPreparationJob ..|> Job
JourneyCompletionJob ..|> Job
PaymentExpiryJob ..|> Job
ChartPreparationJob --> CancellationService : cancel waitlisted
ChartPreparationJob --> PaymentService : full refunds
@enduml
