# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Local Docker database (see docker-compose.yml at the repository root),
# or a Neon connection string with the +psycopg driver, e.g.
# postgresql+psycopg://USER:PASSWORD@HOST/berth?sslmode=require
DATABASE_URL=postgresql+psycopg://berth:berth@localhost:5432/berth

# Long random strings. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CRON_SECRET=

# Optional: passwords for the demo accounts created by `uv run python -m scripts.seed`
# (admin@example.com and demo@example.com). Leave empty to skip creating them.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
